{
  "name": "aqara-g5pro-mqtt",
  "description": "Aqara Cameras Local RTSP & MQTT Integration",
  "version": "1.6.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:native": "tsx src/scripts/build-native.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:native": "clang-format -i native/src/**/*.cpp native/src/**/*.hpp",
    "format:all": "pnpm run format && pnpm run format:native",
    "lint": "oxlint && prettier --check \"src/**/*.{ts,js,json}\"",
    "lint:oxlint": "oxlint",
    "lint:native": "clang-format --dry-run -Werror native/src/**/*.cpp native/src/**/*.hpp",
    "lint:all": "pnpm run lint && pnpm run lint:native",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "rtsp": "tsx src/scripts/rtsp/server.ts",
    "rtsp:probe": "tsx src/scripts/rtsp/probe.ts",
    "setup": "tsx src/scripts/setup.ts",
    "login": "tsx src/scripts/login.ts",
    "cameras:list": "tsx src/scripts/cameras/list-p2p.ts",
    "audio:talkback": "tsx src/scripts/audio/talkback-sample.ts",
    "test": "node --import tsx --test src/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.0",
    "clang-format": "^1.8.0",
    "inquirer": "^8.2.7",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "axios": "^1.11.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.1",
    "mqtt": "^5.14.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "uuid": "^11.1.0",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  }
}
