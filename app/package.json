{
  "name": "aqara-g5pro-mqtt",
  "description": "MQTT bridge for integrating Aqara G5 Pro with Home Assistant",
  "version": "1.4.5",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "rtsp": "tsx src/scripts/rtsp/server.ts",
    "rtsp:probe": "tsx src/scripts/rtsp/probe.ts",
    "setup": "tsx src/scripts/setup.ts",
    "login": "tsx src/scripts/login.ts",
    "cameras:list": "tsx src/scripts/cameras/list-p2p.ts",
    "audio:talkback": "tsx src/scripts/audio/talkback-sample.ts",
    "test": "node --import tsx --test src/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "inquirer": "^8.2.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "mqtt": "^5.14.0",
    "uuid": "^11.1.0",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  }
}
