{
  "name": "aqara-cameras-bridge",
  "description": "Aqara Cameras Local RTSP & MQTT Integration",
  "version": "1.6.2",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "start": "pnpm -C app run start",
    "dev": "pnpm -C app run dev",
    "build": "pnpm -C app run build",
    "build:native": "pnpm -C app run build:native",
    "format": "pnpm -C app run format",
    "format:native": "pnpm -C app run format:native",
    "format:all": "pnpm -C app run format:all",
    "lint": "pnpm -C app run lint",
    "lint:oxlint": "pnpm -C app run lint:oxlint",
    "lint:native": "pnpm -C app run lint:native",
    "lint:all": "pnpm -C app run lint:all",
    "rtsp": "pnpm -C app run rtsp",
    "rtsp:probe": "pnpm -C app run rtsp:probe",
    "setup": "pnpm -C app run setup",
    "login": "pnpm -C app run login",
    "cameras:list": "pnpm -C app run cameras:list",
    "audio:talkback": "pnpm -C app run audio:talkback",
    "test": "pnpm -C app test"
  }
}
